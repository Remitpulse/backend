# Copy to .env and fill in. See README.md for a full explanation of each corridor/anchor/contract value.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Applied to endpoints that spend relayer/paymaster funds or hit anchors
SENSITIVE_RATE_LIMIT_MAX=20

DATABASE_URL=postgresql://remitpulse:remitpulse@localhost:5432/remitpulse

# Comma-separated API keys accepted in the x-api-key header for /v1/admin/* routes
ADMIN_API_KEYS=change-me-admin-key
# openssl rand -hex 32
JWT_SECRET=replace-with-a-random-64-char-hex-string
JWT_EXPIRATION=7d
# 32-byte key (hex or base64) used to encrypt anchor JWTs at rest — openssl rand -hex 32
ENCRYPTION_KEY=replace-with-a-random-32-byte-key

# --- Stellar network ---------------------------------------------------------
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_AUTH_HEADER_NAME=
STELLAR_RPC_AUTH_HEADER_VALUE=
STELLAR_TX_TIMEOUT_SECONDS=60
STELLAR_BASE_FEE=100

# --- Contracts ----------------------------------------------------------------
# Deployed smart-wallet factory contract
ACCOUNT_CONTRACT_ID=C...
# On-chain fee-subsidy ledger contract
SUBSIDY_CONTRACT_ID=C...
# Extra contracts users may invoke through the relay, comma-separated
RELAY_ALLOWED_CONTRACTS=

# --- Keys -----------------------------------------------------------------------
# Funded Stellar account that sources relayed Soroban invocations (pays network sequence)
RELAYER_SECRET_KEY=S...
# Funded Stellar account that fee-bumps (sponsors) user transactions
PAYMASTER_SECRET_KEY=S...

# --- Paymaster policy -----------------------------------------------------------
PAYMASTER_MAX_FEE_STROOPS=5000000
PAYMASTER_DAILY_BUDGET_STROOPS=50000000
PAYMASTER_ENFORCE_SUBSIDY=false

# --- WebAuthn (passkeys) ---------------------------------------------------------
WEBAUTHN_RP_NAME=RemitPulse
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5173
WEBAUTHN_CHALLENGE_TTL_SECONDS=300

# --- Session keys (amounts in whole token units) ----------------------------------
SESSION_KEY_MAX_PER_TX=25
SESSION_KEY_MAX_TOTAL=200
SESSION_KEY_MAX_TTL_SECONDS=604800

# --- SEP-10 / SEP-24 anchors --------------------------------------------------------
SEP10_HOME_DOMAIN=remitpulse.app
# Optional: RemitPulse's own wallet client_domain, if it publishes a stellar.toml
SEP10_CLIENT_DOMAIN=
SEP10_CLIENT_DOMAIN_SECRET=
# Only ever takes effect for loopback/local anchor hostnames (localhost, 127.0.0.1, ::1);
# real anchor domains always use HTTPS regardless of this flag
ANCHOR_ALLOW_HTTP=false
ANCHOR_REQUEST_TIMEOUT_MS=15000
WEBHOOK_REQUIRE_SIGNATURE=true
WEBHOOK_MAX_AGE_SECONDS=300
# HMAC seed used to derive per-user custodial anchor accounts — openssl rand -hex 32
ANCHOR_CUSTODY_SEED=replace-with-a-random-32-byte-seed

# --- Remittance status poller -------------------------------------------------------
# Background job that re-syncs non-terminal remittance transactions with their anchor
# (fallback for missed/failed anchor webhooks). Set interval to 0 to disable the poller.
# How often the poller runs, in seconds
REMITTANCE_POLL_INTERVAL_SECONDS=60
# Only re-sync transactions whose updatedAt is older than this many seconds
REMITTANCE_POLL_STALE_AFTER_SECONDS=300
# Max transactions synced per poll tick (limits concurrent anchor requests)
REMITTANCE_POLL_BATCH_SIZE=10
# Non-terminal transactions older than this are marked failed instead of polled forever
# (e.g. an abandoned SEP-24 interactive session); default is 7 days
REMITTANCE_EXPIRE_AFTER_SECONDS=604800

# --- FX -----------------------------------------------------------------------------
FX_PROVIDER=static
FX_STATIC_RATES={"USD":1,"EUR":0.92,"ARS":1050,"BRL":5.6}
FX_REFERENCE_URL=
FX_CACHE_TTL_SECONDS=60

# Leave blank to disable error reporting entirely
SENTRY_DSN=
