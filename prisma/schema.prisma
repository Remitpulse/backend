// RemitPulse data model.
// Run `npm run db:migrate` after editing to generate a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & smart wallets
// ---------------------------------------------------------------------------

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  // C-address of the user's deployed smart wallet (null until deployed)
  contractAddress String?  @unique @map("contract_address")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  passkeys     Passkey[]
  sessionKeys  SessionKey[]
  invocations  PendingInvocation[]
  sponsored    SponsoredTransaction[]
  remittances  RemittanceTransaction[]
  anchorAuths  AnchorSession[]

  @@map("users")
}

model Passkey {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  // base64url WebAuthn credential id
  credentialId        String    @unique @map("credential_id")
  // COSE-encoded public key, used by @simplewebauthn to verify assertions
  credentialPublicKey Bytes     @map("credential_public_key")
  // Uncompressed secp256r1 point (65 bytes, hex) as stored on the account contract
  hexPublicKey        String    @map("hex_public_key")
  counter             BigInt    @default(0)
  transports          String?
  deviceType          String    @map("device_type")
  backedUp            Boolean   @map("backed_up")
  label               String?
  lastUsedAt          DateTime? @map("last_used_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

enum ChallengePurpose {
  registration
  authentication

  @@map("challenge_purpose")
}

model WebAuthnChallenge {
  id         String           @id @default(uuid()) @db.Uuid
  // Normalised email for registration/login, invocation id for contract auth
  subject    String
  purpose    ChallengePurpose
  challenge  String
  expiresAt  DateTime         @map("expires_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([subject, purpose])
  @@map("webauthn_challenges")
}

enum SessionKeyStatus {
  pending
  active
  revoked
  expired

  @@map("session_key_status")
}

// Scoped Ed25519 signer registered on a user's smart wallet for low-value payments
model SessionKey {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  // Ed25519 public key (G... strkey) held by the client device
  publicKey       String           @unique @map("public_key")
  // SAC / token contract this key is allowed to move
  tokenContract   String           @map("token_contract")
  // Limits in token base units (7 decimals), stored as strings to avoid precision loss
  perTxLimit      Decimal          @map("per_tx_limit") @db.Decimal(39, 0)
  totalLimit      Decimal          @map("total_limit") @db.Decimal(39, 0)
  spent           Decimal          @default(0) @db.Decimal(39, 0)
  expiresAtLedger Int              @map("expires_at_ledger")
  expiresAt       DateTime         @map("expires_at")
  status          SessionKeyStatus @default(pending)
  registerTxHash  String?          @map("register_tx_hash")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("session_keys")
}

enum InvocationKind {
  wallet_deploy
  contract_call
  session_key_register
  session_key_revoke
  payment

  @@map("invocation_kind")
}

enum InvocationStatus {
  awaiting_signature
  submitted
  succeeded
  failed
  expired

  @@map("invocation_status")
}

// A simulated Soroban invocation waiting for the user's auth-entry signature
model PendingInvocation {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  kind              InvocationKind
  contractId        String           @map("contract_id")
  method            String
  // Base64 XDR of the unsigned transaction and of the auth entry the user must sign
  txXdr             String           @map("tx_xdr")
  authEntryXdr      String?          @map("auth_entry_xdr")
  validUntilLedger  Int?             @map("valid_until_ledger")
  // base64url SHA-256 of the HashIdPreimageSorobanAuthorization (the signature payload)
  authPayload       String?          @map("auth_payload")
  signer            String           // "passkey" | "session_key" | "none"
  sessionKeyId      String?          @map("session_key_id") @db.Uuid
  metadata          Json?
  status            InvocationStatus @default(awaiting_signature)
  txHash            String?          @map("tx_hash")
  error             String?
  expiresAt         DateTime         @map("expires_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("pending_invocations")
}

enum SponsorshipStatus {
  submitted
  succeeded
  failed

  @@map("sponsorship_status")
}

// Every transaction the paymaster has fee-bumped, used for accounting and quota enforcement
model SponsoredTransaction {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String?           @map("user_id") @db.Uuid
  innerHash    String            @unique @map("inner_hash")
  feeBumpHash  String            @unique @map("fee_bump_hash")
  // Max fee authorised by the fee-bump envelope, in stroops
  maxFee       BigInt            @map("max_fee")
  // Actual fee charged by the network, in stroops (known after confirmation)
  feeCharged   BigInt?           @map("fee_charged")
  contractId   String?           @map("contract_id")
  method       String?
  status       SponsorshipStatus @default(submitted)
  error        String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("sponsored_transactions")
}

// ---------------------------------------------------------------------------
// Remittance corridors (SEP-1 / SEP-10 / SEP-24)
// ---------------------------------------------------------------------------

model Corridor {
  id               String   @id @default(uuid()) @db.Uuid
  // Short code used in URLs, e.g. "USDC", "EURC", "ARST", "BRLA"
  code             String   @unique
  name             String
  assetCode        String   @map("asset_code")
  assetIssuer      String   @map("asset_issuer")
  // ISO-4217 fiat currency the anchor pays out / takes in, e.g. "USD", "ARS"
  fiatCurrency     String   @map("fiat_currency")
  // Anchor home domain hosting stellar.toml (SEP-1)
  anchorDomain     String   @map("anchor_domain")
  // RemitPulse markup applied on top of the reference FX rate, in basis points
  markupBps        Int      @default(0) @map("markup_bps")
  // Flat RemitPulse fee per transfer, denominated in the corridor asset
  fixedFee         Decimal  @default(0) @map("fixed_fee") @db.Decimal(20, 7)
  minAmount        Decimal  @default(0) @map("min_amount") @db.Decimal(20, 7)
  maxAmount        Decimal? @map("max_amount") @db.Decimal(20, 7)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  remittances RemittanceTransaction[]
  anchorAuths AnchorSession[]

  @@map("corridors")
}

// SEP-10 JWT issued by an anchor, encrypted at rest
model AnchorSession {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  corridorId     String   @map("corridor_id") @db.Uuid
  // Stellar account the JWT was issued for (G... or C...)
  account        String
  encryptedToken String   @map("encrypted_token")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  corridor Corridor @relation(fields: [corridorId], references: [id], onDelete: Cascade)

  @@unique([userId, corridorId, account])
  @@map("anchor_sessions")
}

enum RemittanceKind {
  deposit
  withdrawal

  @@map("remittance_kind")
}

// RemitPulse lifecycle, normalised from the anchor's SEP-24 status
enum RemittanceStatus {
  incomplete
  pending_user_transfer
  pending_anchor
  completed
  failed

  @@map("remittance_status")
}

model RemittanceTransaction {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  corridorId      String           @map("corridor_id") @db.Uuid
  kind            RemittanceKind
  account         String
  // Transaction id assigned by the anchor's SEP-24 server
  anchorTxId      String           @map("anchor_tx_id")
  status          RemittanceStatus @default(incomplete)
  // Raw SEP-24 status as last reported by the anchor
  anchorStatus    String           @map("anchor_status")
  amountIn        Decimal?         @map("amount_in") @db.Decimal(20, 7)
  amountOut       Decimal?         @map("amount_out") @db.Decimal(20, 7)
  amountFee       Decimal?         @map("amount_fee") @db.Decimal(20, 7)
  // RemitPulse fee quoted to the user at initiation
  platformFee     Decimal?         @map("platform_fee") @db.Decimal(20, 7)
  quotedRate      Decimal?         @map("quoted_rate") @db.Decimal(30, 12)
  interactiveUrl  String?          @map("interactive_url")
  moreInfoUrl     String?          @map("more_info_url")
  stellarTxHash   String?          @map("stellar_transaction_id")
  // Withdrawal: where/how the user must send funds to the anchor
  withdrawAnchorAccount String?    @map("withdraw_anchor_account")
  withdrawMemo          String?    @map("withdraw_memo")
  withdrawMemoType      String?    @map("withdraw_memo_type")
  statusMessage   String?          @map("status_message")
  completedAt     DateTime?        @map("completed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  corridor Corridor          @relation(fields: [corridorId], references: [id])
  events   RemittanceEvent[]

  @@unique([corridorId, anchorTxId])
  @@index([userId, createdAt])
  @@index([status])
  @@index([status, updatedAt])
  @@map("remittance_transactions")
}

enum RemittanceEventSource {
  initiation
  webhook
  poll

  @@map("remittance_event_source")
}

// Append-only audit trail of every status observation
model RemittanceEvent {
  id            String                @id @default(uuid()) @db.Uuid
  transactionId String                @map("transaction_id") @db.Uuid
  source        RemittanceEventSource
  fromStatus    RemittanceStatus?     @map("from_status")
  toStatus      RemittanceStatus      @map("to_status")
  anchorStatus  String                @map("anchor_status")
  payload       Json
  createdAt     DateTime              @default(now()) @map("created_at")

  transaction RemittanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, createdAt])
  @@map("remittance_events")
}
